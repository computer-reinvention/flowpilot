#!/usr/bin/env bash
# deploy — FlowPilot production deployment utility
# Usage: ./deploy <command>
#   setup      First-time: install Docker + Caddy, configure .env, build, start
#   up         Start all containers
#   stop       Stop all containers (including leftover sandbox containers)
#   build      Rebuild all Docker images (sandbox + backend)
#   restart    stop → build → up
#   logs [q]   Follow logs (press q to stop, or pass "q" to skip)
#   status     Show container and Caddy status

set -euo pipefail

COMPOSE_FILE="$(cd "$(dirname "$0")" && pwd)/docker-compose.yml"
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$PROJECT_DIR/.env"
CADDY_SITE_FILE="/etc/caddy/sites/flowpilot.caddy"

# ── colours ──────────────────────────────────────────────────────────────────
bold=$'\e[1m'; reset=$'\e[0m'
green=$'\e[32m'; cyan=$'\e[36m'; yellow=$'\e[33m'; red=$'\e[31m'

info()   { echo "${cyan}→${reset} $*"; }
ok()     { echo "${green}✓${reset} $*"; }
warn()   { echo "${yellow}!${reset} $*"; }
die()    { echo "${red}✗${reset} $*" >&2; exit 1; }
header() { echo ""; echo "  ${bold}$*${reset}"; echo ""; }

require_root() {
  [[ $EUID -eq 0 ]] || die "Run as root: sudo ./deploy $CMD"
}

# ── helpers ───────────────────────────────────────────────────────────────────

_install_docker() {
  if command -v docker &>/dev/null; then
    ok "Docker already installed: $(docker --version | cut -d' ' -f3 | tr -d ',')"
    return
  fi
  info "Installing Docker Engine..."
  curl -fsSL https://get.docker.com | sh
  # Allow the current non-root user (if sudo was used) to run Docker
  REAL_USER="${SUDO_USER:-}"
  if [[ -n "$REAL_USER" ]]; then
    usermod -aG docker "$REAL_USER"
    warn "Added $REAL_USER to the docker group — effective on next login."
  fi
  ok "Docker installed."
}

_install_caddy() {
  if command -v caddy &>/dev/null; then
    ok "Caddy already installed: $(caddy version 2>/dev/null | head -1)"
    return
  fi
  info "Installing Caddy..."
  apt-get update -q
  apt-get install -y -q debian-keyring debian-archive-keyring apt-transport-https curl
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
    | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
    | tee /etc/apt/sources.list.d/caddy-stable.list > /dev/null
  apt-get update -q && apt-get install -y -q caddy
  ok "Caddy installed."
}

_configure_caddy() {
  local domain="$1"

  mkdir -p /etc/caddy/sites

  # If the Caddyfile is the stock default (contains `:80` site block) or has
  # never been customised, replace it entirely. Otherwise prepend the import.
  if ! grep -q "import /etc/caddy/sites" /etc/caddy/Caddyfile 2>/dev/null; then
    if grep -qE '^\s*:80\s*\{' /etc/caddy/Caddyfile 2>/dev/null; then
      # Stock Caddyfile — replace with just the import
      info "Replacing default Caddyfile (had stock :80 block)."
      echo "import /etc/caddy/sites/*.caddy" > /etc/caddy/Caddyfile
    else
      # Custom Caddyfile — prepend import at the top
      local tmp
      tmp=$(mktemp)
      echo "import /etc/caddy/sites/*.caddy" > "$tmp"
      echo "" >> "$tmp"
      cat /etc/caddy/Caddyfile >> "$tmp"
      mv "$tmp" /etc/caddy/Caddyfile
    fi
    info "Caddyfile now imports /etc/caddy/sites/*.caddy"
  fi

  cat > "$CADDY_SITE_FILE" << EOF
${domain} {
    reverse_proxy localhost:8080 {
        header_up Host             {host}
        header_up X-Real-IP        {remote_host}
        header_up X-Forwarded-For  {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Keep WebSocket (run progress + browser canvas) and HITL-paused connections alive
        transport http {
            read_timeout 1h
        }
    }
}
EOF

  # Validate before restarting — show the error if it fails
  if ! caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile 2>/dev/null; then
    warn "Caddy config validation failed. Check /etc/caddy/Caddyfile"
    warn "You may need to remove the default :80 site block that ships with Caddy."
    return 1
  fi

  systemctl enable caddy 2>/dev/null || true
  if systemctl is-active --quiet caddy; then
    systemctl reload caddy
  else
    systemctl start caddy
  fi
  ok "Caddy configured → https://${domain}"
}

_create_env() {
  header "Environment configuration"

  read -rp "  Domain (e.g. flowpilot.technology): " DOMAIN
  [[ -n "$DOMAIN" ]] || die "Domain is required."

  echo ""
  echo "  LLM providers: gemini | claude | openai"
  read -rp "  Provider [gemini]: " LLM_PROVIDER
  LLM_PROVIDER="${LLM_PROVIDER:-gemini}"

  local api_key_line=""
  case "$LLM_PROVIDER" in
    gemini)
      read -rp "  Google API key: " _key
      api_key_line="GOOGLE_API_KEY=${_key}"
      ;;
    claude|anthropic)
      LLM_PROVIDER="claude"
      read -rp "  Anthropic API key: " _key
      api_key_line="ANTHROPIC_API_KEY=${_key}"
      ;;
    openai)
      read -rp "  OpenAI API key: " _key
      api_key_line="OPENAI_API_KEY=${_key}"
      ;;
    *)
      die "Unknown provider: $LLM_PROVIDER (use gemini, claude, or openai)"
      ;;
  esac

  local jwt_secret
  jwt_secret=$(openssl rand -hex 32)

  cat > "$ENV_FILE" << EOF
# Generated by ./deploy setup — edit as needed

LLM_PROVIDER=${LLM_PROVIDER}
${api_key_line}

JWT_SECRET=${jwt_secret}

FLOWPILOT_BASE_URL=https://${DOMAIN}
ALLOWED_ORIGINS=https://${DOMAIN}
PROFILES_HOST_DIR=${PROJECT_DIR}/profiles
EOF

  ok ".env created."
  echo "$DOMAIN"
}

# ── commands ──────────────────────────────────────────────────────────────────

cmd_setup() {
  require_root
  header "FlowPilot — First-time setup"

  _install_docker
  _install_caddy

  local domain=""
  if [[ -f "$ENV_FILE" ]]; then
    warn ".env already exists — skipping interactive setup."
    warn "Delete $ENV_FILE and re-run to reconfigure."
    # Extract domain from existing env
    domain=$(grep -E '^FLOWPILOT_BASE_URL=' "$ENV_FILE" 2>/dev/null \
             | sed 's|FLOWPILOT_BASE_URL=||;s|https://||;s|http://||' || true)
  else
    domain=$(_create_env)
  fi

  mkdir -p "$PROJECT_DIR/profiles"
  ok "Profiles directory: $PROJECT_DIR/profiles"

  if [[ -n "$domain" ]]; then
    _configure_caddy "$domain"
  fi

  echo ""
  cmd_build
  echo ""
  cmd_up
  echo ""
  ok "Setup complete. Visit: https://${domain}"
}

cmd_build() {
  info "Building sandbox image (Chromium + CDP)..."
  docker build -t flowpilot-sandbox:latest \
    -f "$PROJECT_DIR/Dockerfile.sandbox" "$PROJECT_DIR"
  ok "Sandbox image built."

  info "Building backend image (includes frontend build)..."
  docker compose -f "$COMPOSE_FILE" build backend
  ok "Backend image built."
}

cmd_up() {
  info "Starting containers..."
  docker compose -f "$COMPOSE_FILE" up -d
  sleep 2
  if docker compose -f "$COMPOSE_FILE" ps 2>/dev/null | grep -qE "Up|running"; then
    ok "All containers running."
  else
    warn "Some containers may have failed — check: docker compose ps"
  fi
}

cmd_stop() {
  info "Stopping containers..."
  docker compose -f "$COMPOSE_FILE" down --timeout 8

  # Sandbox containers are spawned outside compose — clean them up too
  local sandbox_ids
  sandbox_ids=$(docker ps -aq --filter label=flowpilot=sandbox 2>/dev/null || true)
  if [[ -n "$sandbox_ids" ]]; then
    warn "Removing leftover sandbox containers..."
    # shellcheck disable=SC2086
    docker rm -f $sandbox_ids 2>/dev/null || true
  fi

  ok "Stopped."
}

cmd_restart() {
  cmd_stop
  echo ""
  cmd_build
  echo ""
  cmd_up
}

cmd_logs() {
  local flag="${1:-}"
  if [[ "$flag" == "q" ]]; then
    info "Last 50 lines:"
    docker compose -f "$COMPOSE_FILE" logs --tail=50
    return
  fi
  info "Following logs — press ${bold}q${reset} then Enter to stop."
  docker compose -f "$COMPOSE_FILE" logs -f --tail=50 &
  LOG_PID=$!
  trap "kill $LOG_PID 2>/dev/null; wait $LOG_PID 2>/dev/null; trap - INT TERM; exit 0" INT TERM
  while IFS= read -r -n1 key; do
    if [[ "$key" == "q" || "$key" == "Q" ]]; then
      kill $LOG_PID 2>/dev/null
      wait $LOG_PID 2>/dev/null
      echo ""
      ok "Stopped."
      break
    fi
  done
  trap - INT TERM
}

cmd_status() {
  echo ""
  echo "  ${bold}Containers${reset}"
  docker compose -f "$COMPOSE_FILE" ps
  echo ""
  echo "  ${bold}Caddy${reset}"
  systemctl is-active caddy 2>/dev/null && echo "  caddy: active" || echo "  caddy: not running"
  echo ""
}

cmd_cleanup() {
  require_root
  header "FlowPilot — Cleanup"

  # Stop all containers
  cmd_stop
  echo ""

  # Remove Caddy site config
  if [[ -f "$CADDY_SITE_FILE" ]]; then
    rm -f "$CADDY_SITE_FILE"
    ok "Removed $CADDY_SITE_FILE"
  fi

  # Remove import line from Caddyfile
  if grep -q "import /etc/caddy/sites/\*.caddy" /etc/caddy/Caddyfile 2>/dev/null; then
    sed -i '/import \/etc\/caddy\/sites\/\*\.caddy/d' /etc/caddy/Caddyfile
    # Remove any resulting blank lines at the top
    sed -i '/./,$!d' /etc/caddy/Caddyfile
    ok "Removed FlowPilot import from Caddyfile"
  fi

  # Reload Caddy if running
  if systemctl is-active --quiet caddy 2>/dev/null; then
    systemctl reload caddy
    ok "Caddy reloaded"
  fi

  # Remove dangling Docker images
  local dangling
  dangling=$(docker images -q --filter dangling=true 2>/dev/null || true)
  if [[ -n "$dangling" ]]; then
    info "Removing dangling Docker images..."
    docker image prune -f >/dev/null 2>&1
    ok "Dangling images removed"
  fi

  # Prompt before removing .env and profiles
  echo ""
  read -rp "  Delete .env and profiles directory? This is irreversible. [y/N]: " confirm
  if [[ "$confirm" =~ ^[Yy]$ ]]; then
    rm -f "$ENV_FILE"
    ok "Removed $ENV_FILE"
    if [[ -d "$PROJECT_DIR/profiles" ]]; then
      rm -rf "$PROJECT_DIR/profiles"
      ok "Removed $PROJECT_DIR/profiles"
    fi
  else
    info "Kept .env and profiles."
  fi

  echo ""
  ok "Cleanup complete."
}

# ── dispatch ──────────────────────────────────────────────────────────────────

CMD="${1:-}"

case "$CMD" in
  setup)    cmd_setup ;;
  build)    cmd_build ;;
  up)       cmd_up ;;
  stop)     cmd_stop ;;
  restart)  cmd_restart ;;
  logs)     cmd_logs "${2:-}" ;;
  status)   cmd_status ;;
  cleanup)  cmd_cleanup ;;
  *)
    echo ""
    echo "  ${bold}FlowPilot deploy utility${reset}"
    echo ""
    echo "  Usage: ${cyan}sudo ./deploy <command>${reset}"
    echo ""
    echo "  Commands:"
    echo "    ${bold}setup${reset}      First-time: Docker + Caddy + env + build + start"
    echo "    ${bold}build${reset}      Rebuild sandbox + backend images"
    echo "    ${bold}up${reset}         Start all containers"
    echo "    ${bold}stop${reset}       Stop all containers"
    echo "    ${bold}restart${reset}    stop → build → up"
    echo "    ${bold}logs${reset}       Follow logs (press q to stop)"
    echo "    ${bold}logs q${reset}     Print last 50 lines without following"
    echo "    ${bold}status${reset}     Container and Caddy status"
    echo "    ${bold}cleanup${reset}    Stop everything, remove Caddy config + dangling images"
    echo ""
    [[ -n "$CMD" ]] && die "Unknown command: $CMD"
    exit 0
    ;;
esac
