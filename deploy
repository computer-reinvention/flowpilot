#!/usr/bin/env bash
# Artifact helper. Host installation, certificate issuance and global cleanup excluded.
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"
export COMPOSE_PARALLEL_LIMIT=1
compose() { docker compose --project-directory "$PROJECT_DIR" -f "$PROJECT_DIR/docker-compose.yml" "$@"; }
die() { echo "$*" >&2; exit 1; }
authorize() {
  [[ "${FLOWPILOT_OPERATOR_CONFIRM:-}" == "manual-host-operation" ]] || die 'Host operations require separate operator approval: FLOWPILOT_OPERATOR_CONFIRM=manual-host-operation'
}
check_env() {
  [[ -f "$PROJECT_DIR/.env" && ! -L "$PROJECT_DIR/.env" ]] || die 'Create a restricted .env manually; credentials are never copied or prompted for.'
  python3 - "$PROJECT_DIR/.env" <<'PY'
import os, stat, sys
st = os.stat(sys.argv[1])
if stat.S_IMODE(st.st_mode) & 0o077 or st.st_uid != os.geteuid():
    raise SystemExit('.env must be owned by the operator and mode 0600')
PY
  # Do not source shell code or print resolved Compose config containing secrets.
  compose config --quiet
}
case "${1:-help}" in
  setup|cleanup) die 'Removed unsafe automation. See docs/hosting-readiness.md; no host installation, global Caddy rewrite or resource pruning is performed.' ;;
  validate) check_env ;;
  build)
    docker build --platform "${FLOWPILOT_PLATFORM:-linux/amd64}" --build-arg "REVISION=${FLOWPILOT_REVISION:-unknown}" -t flowpilot-sandbox:latest -f "$PROJECT_DIR/Dockerfile.sandbox" "$PROJECT_DIR"
    compose build backend ;;
  up) authorize; check_env; compose up -d --wait --wait-timeout 120 ;;
  stop) authorize; compose stop --timeout 65 ;;
  restart) authorize; check_env; compose restart --timeout 65 backend ;;
  logs) compose logs --tail=50 backend ;;
  status) compose ps ;;
  *) echo 'Usage: ./deploy {validate|build|up|stop|restart|logs|status}. No automatic install, cleanup or credential copy.' ;;
esac
