# flowpilot sandbox image
# Provides: Chromium + CDP (via socat) + Xvfb
# Ports: 9222 (CDP direct), 9223 (socat-forwarded CDP — accessible cross-container)

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:1 \
    RESOLUTION=1920x1080x24

# ── System dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Browser
    chromium \
    chromium-sandbox \
    # Virtual framebuffer (Chromium still needs a display for proper rendering)
    xvfb \
    # Process manager
    supervisor \
    # TCP forwarder (Chromium ignores --remote-debugging-address on ARM)
    socat \
    # Utilities
    curl \
    procps \
    x11-utils \
    dbus-x11 \
    # Fonts (Chromium needs at least one font family)
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-dejavu-core \
    # Libraries Chromium needs
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
    libxkbcommon0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# ── Python packages ──────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    browser-use \
    playwright \
    && playwright install chromium \
    && playwright install-deps chromium \
    && chmod 755 /root \
    && chmod -R o+rX /root/.cache/ms-playwright

# ── Non-root user ────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash sandboxuser

# ── Directory structure ──────────────────────────────────────────────
RUN mkdir -p \
    /profiles \
    /tmp/chrome-profile \
    /var/log/supervisor \
    /var/run/supervisor \
    && chown -R sandboxuser:sandboxuser /tmp/chrome-profile /profiles

# ── Supervisord config ───────────────────────────────────────────────
COPY sandbox/supervisord.conf /etc/supervisor/conf.d/sandbox.conf

# ── Entrypoint ───────────────────────────────────────────────────────
COPY sandbox/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── Volumes & Ports ──────────────────────────────────────────────────
VOLUME ["/profiles"]
EXPOSE 9222 9223

# ── Health check ─────────────────────────────────────────────────────
HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:9222/json/version > /dev/null

ENTRYPOINT ["/entrypoint.sh"]
