# flowpilot sandbox image
# Provides: Chromium + VNC + noVNC + browser-use + Playwright
# Ports: 6080 (noVNC web UI), 5900 (VNC direct)

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive \
    DISPLAY=:1 \
    RESOLUTION=1280x720x24 \
    NOVNC_PORT=6080 \
    VNC_PORT=5900

# ── System dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Browser
    chromium \
    chromium-sandbox \
    # Display server
    xvfb \
    # Window manager
    fluxbox \
    # VNC server
    tigervnc-standalone-server \
    tigervnc-common \
    # Process manager
    supervisor \
    # Utilities needed for noVNC build / general use
    git \
    curl \
    wget \
    procps \
    net-tools \
    x11-utils \
    x11-xserver-utils \
    dbus-x11 \
    xdg-utils \
    # Fonts (Chromium needs at least one font family)
    fonts-liberation \
    fonts-noto-color-emoji \
    fonts-dejavu-core \
    # Libraries Chromium / Playwright may need
    libnss3 \
    libatk-bridge2.0-0 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
    libxkbcommon0 \
    libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

# ── noVNC from GitHub release ────────────────────────────────────────
RUN git clone --depth 1 --branch v1.5.0 https://github.com/novnc/noVNC.git /opt/noVNC \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html

# ── Python packages ──────────────────────────────────────────────────
RUN pip install --no-cache-dir \
    websockify \
    browser-use \
    playwright \
    && playwright install chromium \
    && playwright install-deps chromium

# ── Non-root user ────────────────────────────────────────────────────
RUN useradd -m -s /bin/bash sandboxuser

# ── Directory structure ──────────────────────────────────────────────
RUN mkdir -p \
    /profiles \
    /tmp/chrome-profile \
    /home/sandboxuser/.vnc \
    /var/log/supervisor \
    /var/run/supervisor \
    && chown -R sandboxuser:sandboxuser /tmp/chrome-profile /home/sandboxuser/.vnc /profiles

# ── Supervisord config ───────────────────────────────────────────────
COPY sandbox/supervisord.conf /etc/supervisor/conf.d/sandbox.conf

# ── Entrypoint ───────────────────────────────────────────────────────
COPY sandbox/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# ── Volumes & Ports ──────────────────────────────────────────────────
VOLUME ["/profiles"]
EXPOSE 6080 5900 9222

# ── Health check ─────────────────────────────────────────────────────
# Verify both noVNC (HTTP) and VNC (TCP) are reachable
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -sf http://localhost:6080/ > /dev/null && (echo > /dev/tcp/localhost/9222) 2>/dev/null && \
        (echo > /dev/tcp/localhost/5900) 2>/dev/null

ENTRYPOINT ["/entrypoint.sh"]
