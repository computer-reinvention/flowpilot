# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Set the key for your chosen provider
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional model override (defaults shown)
# GEMINI_MODEL=gemini-4-argon
# GEMINI_EXPLORATION_MODEL=gemini-4-argon
# GEMINI_FAST_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EXPLORATION_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_EXPLORATION_MODEL=gpt-6.1-sol
# OPENAI_FAST_MODEL=gpt-6-luna

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be set in production — tokens won't survive restarts without a stable secret.
JWT_SECRET=

# ── Deployment ────────────────────────────────────────────────────────────────
# Public-facing URL (used in webhook payloads and CDP stream URLs)
FLOWPILOT_BASE_URL=http://localhost:8080

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Host-absolute path to the profiles directory.
# Must be the HOST path (not the container path) — sandbox containers mount it directly.
# Compose defaults to the profiles directory under the current project.
# PROFILES_HOST_DIR=/absolute/path/to/flowpilot/profiles
# Agent driver: browser-use (default) or pi (requires Node >=22.19 and npm ci in agent-host)
AGENT_DRIVER=browser-use
# Default local chat identity (not a dashboard login/password)
FLOWPILOT_REPL_USER=
# Subscription alternative: LLM_PROVIDER=codex and AGENT_DRIVER=pi.
# First run: node agent-host/login.mjs
CODEX_MODEL=gpt-6.1-sol
CODEX_EXPLORATION_MODEL=
CODEX_FAST_MODEL=
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Optional OCI runtime, e.g. runsc on a gVisor-configured Linux Docker host
SANDBOX_RUNTIME=
# Hosting starts disabled until assembled acceptance and host policy are verified.
FLOWPILOT_TASKS_ENABLED=false
FLOWPILOT_TASKS_MAX_ACTIVE_BROWSERS=2
FLOWPILOT_TASKS_MAX_ACCOUNT_BROWSERS=1
FLOWPILOT_TASKS_MAX_BODY_BYTES=65536
FLOWPILOT_TASKS_POLL_WAIT_SECONDS=25
FLOWPILOT_TASKS_TASK_TIMEOUT_SECONDS=900
FLOWPILOT_TASKS_HUMAN_WAIT_SECONDS=600
FLOWPILOT_TASKS_IDLE_SESSION_SECONDS=300
FLOWPILOT_TASKS_CANCELLATION_SECONDS=30
FLOWPILOT_TASKS_SHUTDOWN_SECONDS=45
FLOWPILOT_TASKS_ASSISTANCE_TTL_SECONDS=300
FLOWPILOT_TASKS_SANDBOX_MEMORY_MB=1024
FLOWPILOT_TASKS_SANDBOX_CPU_CORES=1
FLOWPILOT_TASKS_SANDBOX_PIDS=1024
FLOWPILOT_TASKS_SANDBOX_SHM_MB=256
FLOWPILOT_TASKS_READINESS_TIMEOUT_SECONDS=10
FLOWPILOT_TASKS_READINESS_WINDOW_SECONDS=0.5
FLOWPILOT_TASKS_NO_PROGRESS_LIMIT=3
FLOWPILOT_TASKS_HISTORY_RETENTION_DAYS=30
FLOWPILOT_TASKS_TRACE_RETENTION_DAYS=7
FLOWPILOT_TASKS_API_REQUESTS_PER_MINUTE=120
FLOWPILOT_TASKS_LOGIN_REQUESTS_PER_MINUTE=10
FLOWPILOT_TASKS_QUARANTINE_MAX_COUNT=16
FLOWPILOT_TASKS_QUARANTINE_MAX_ACCOUNT_COUNT=4
FLOWPILOT_TASKS_QUARANTINE_MAX_BYTES=17179869184
FLOWPILOT_TASKS_QUARANTINE_MAX_ACCOUNT_BYTES=4294967296
FLOWPILOT_TASKS_QUARANTINE_RESERVE_BYTES=1073741824
FLOWPILOT_PLATFORM=linux/amd64
FLOWPILOT_TRACE=0
# Host Caddy service must receive these explicitly in its own restricted environment.
FLOWPILOT_DOMAIN=
FLOWPILOT_EXTERNAL_HOST=
# After proving Docker NAT source locally, choose individual addresses only:
# 127.0.0.1 or 172.30.240.1 (packaged sandbox gateway). Never '*' or a subnet.
FLOWPILOT_TRUSTED_PROXY_IPS=127.0.0.1
# Requires operator-managed refresh; auth.json must be 0600 and directory writable
# only by container uid 10001. Never add subscription credentials to build context.
