# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Set the key for your chosen provider
GOOGLE_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional model override (defaults shown)
# GEMINI_MODEL=gemini-3-flash-preview
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be set in production — tokens won't survive restarts without a stable secret.
JWT_SECRET=changeme

# ── Deployment ────────────────────────────────────────────────────────────────
# Public-facing URL (used in webhook payloads and CDP stream URLs)
FLOWPILOT_BASE_URL=https://flowpilot.technology

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://flowpilot.technology

# Host-absolute path to the profiles directory.
# Must be the HOST path (not the container path) — sandbox containers mount it directly.
PROFILES_HOST_DIR=/opt/flowpilot/profiles
