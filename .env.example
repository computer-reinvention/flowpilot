# LLM Provider: gemini, claude, or openai
LLM_PROVIDER=gemini

# API Keys (set the one matching your provider)
GOOGLE_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Model override — fallback order (start with the fastest, escalate as needed)
# GEMINI_MODEL=gemini-3.1-flash-lite-preview   # default: fastest & cheapest
# GEMINI_MODEL=gemini-3-flash-preview           # fallback: stronger reasoning
# GEMINI_MODEL=gemini-3.1-pro-preview           # fallback: most capable
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o

# Token signing — auto-generated if unset, but tokens won't survive restarts
JWT_SECRET=changeme
