# ── LLM ──────────────────────────────────────────────────────────────────────
# Provider: gemini | claude | openai
LLM_PROVIDER=gemini

# Set the key for your chosen provider
GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# Optional model override (defaults shown)
# GEMINI_MODEL=gemini-4-argon
# GEMINI_EXPLORATION_MODEL=gemini-4-argon
# GEMINI_FAST_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EXPLORATION_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# OPENAI_MODEL=gpt-6.1-sol
# OPENAI_EXPLORATION_MODEL=gpt-6.1-sol
# OPENAI_FAST_MODEL=gpt-6-luna

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
# Must be set in production — tokens won't survive restarts without a stable secret.
JWT_SECRET=changeme

# ── Deployment ────────────────────────────────────────────────────────────────
# Public-facing URL (used in webhook payloads and CDP stream URLs)
FLOWPILOT_BASE_URL=http://localhost:8080

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Host-absolute path to the profiles directory.
# Must be the HOST path (not the container path) — sandbox containers mount it directly.
# Compose defaults to the profiles directory under the current project.
# PROFILES_HOST_DIR=/absolute/path/to/flowpilot/profiles
# Agent driver: browser-use (default) or pi (requires Node >=22.19 and npm ci in agent-host)
AGENT_DRIVER=browser-use
# Default local chat identity (not a dashboard login/password)
FLOWPILOT_REPL_USER=
# Subscription alternative: LLM_PROVIDER=codex and AGENT_DRIVER=pi.
# First run: node agent-host/login.mjs
CODEX_MODEL=gpt-6.1-sol
CODEX_EXPLORATION_MODEL=
CODEX_FAST_MODEL=
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Optional OCI runtime, e.g. runsc on a gVisor-configured Linux Docker host
SANDBOX_RUNTIME=
