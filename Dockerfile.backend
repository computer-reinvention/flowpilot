# ── Stage 1: build frontend ──────────────────────────────────────────────────
FROM node:22-bookworm-slim AS frontend-builder

WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

COPY frontend/ ./
RUN npm run build

FROM node:22-bookworm-slim AS agent-builder
WORKDIR /app/agent-host
COPY agent-host/package*.json ./
RUN npm ci --omit=dev
COPY agent-host/*.mjs ./

# ── Stage 2: Python backend ───────────────────────────────────────────────────
FROM python:3.12-slim

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev

# Install Playwright's Chromium (used by the reflex runner)
RUN uv run playwright install chromium && uv run playwright install-deps

COPY backend/ ./backend/
COPY --from=agent-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-builder /app/agent-host/ ./agent-host/
COPY --from=frontend-builder /app/frontend/dist/ ./frontend/

EXPOSE 8080
CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8080"]
