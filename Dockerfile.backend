# ── Stage 1: build frontend ──────────────────────────────────────────────────
FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS frontend-builder

WORKDIR /app/frontend
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

COPY frontend/ ./
RUN npm run build

FROM node:22.22.0-bookworm-slim@sha256:dd9d21971ec4395903fa6143c2b9267d048ae01ca6d3ea96f16cb30df6187d94 AS agent-builder
WORKDIR /app/agent-host
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY agent-host/package*.json ./
RUN npm ci --omit=dev
COPY agent-host/*.mjs ./

# ── Stage 2: Python backend ───────────────────────────────────────────────────
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 /uv /uvx /bin/

WORKDIR /app
ENV UV_CONCURRENT_DOWNLOADS=2 UV_CONCURRENT_INSTALLS=1

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project

# Install Playwright's Chromium (used by the reflex runner)
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN .venv/bin/playwright install --with-deps chromium

COPY backend/ ./backend/
COPY --from=agent-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-builder /app/agent-host/ ./agent-host/
COPY --from=frontend-builder /app/frontend/dist/ ./frontend/
COPY scripts/ops_health.py scripts/ops_config.py ./scripts/
COPY scripts/ops_start.sh ./scripts/
COPY scripts/ops_logging.json ./scripts/
RUN useradd --uid 10001 --create-home flowpilot && mkdir -p /app/profiles /app/.pi-auth && chown -R flowpilot:flowpilot /app/profiles /app/.pi-auth
USER flowpilot
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=3 CMD ["/app/.venv/bin/python", "/app/scripts/ops_health.py"]

EXPOSE 8080
CMD ["/bin/sh", "/app/scripts/ops_start.sh"]
