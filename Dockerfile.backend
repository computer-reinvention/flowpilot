# ── Stage 1: build frontend ──────────────────────────────────────────────────
FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS frontend-builder

WORKDIR /app/frontend
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

COPY frontend/ ./
RUN npm run build

FROM node:22.23.4-bookworm-slim@sha256:de170b39439eb0e5a3444ad7d60b015614a381e10fecae2e30ec9e735122f38d AS agent-builder
WORKDIR /app/agent-host
ENV NODE_OPTIONS=--max-old-space-size=1024
COPY agent-host/package*.json ./
RUN npm ci --omit=dev
COPY agent-host/*.mjs ./

# ── Stage 2: Python backend ───────────────────────────────────────────────────
FROM python:3.12.15-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.9.5@sha256:f459f6f73a8c4ef5d69f4e6fbbdb8af751d6fa40ec34b39a1ab469acd6e289b7 /uv /uvx /bin/

WORKDIR /app
ENV UV_CONCURRENT_DOWNLOADS=2 UV_CONCURRENT_INSTALLS=1

# Install Python dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project

# Install Playwright's Chromium (used by the reflex runner). Bookworm point/security
# updates are applied first, within the pinned suite (scripts/ops_image_audit.py gates
# the result; accepted findings live in scripts/ops_image_allowlist.json).
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/playwright PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && .venv/bin/playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

COPY backend/ ./backend/
COPY --from=agent-builder /usr/local/bin/node /usr/local/bin/node
COPY --from=agent-builder /app/agent-host/ ./agent-host/
COPY --from=frontend-builder /app/frontend/dist/ ./frontend/
COPY scripts/ops_health.py scripts/ops_config.py ./scripts/
COPY scripts/ops_start.sh ./scripts/
COPY scripts/ops_logging.json ./scripts/
RUN useradd --uid 10001 --create-home flowpilot && mkdir -p /app/profiles /app/.pi-auth && chown -R flowpilot:flowpilot /app/profiles /app/.pi-auth
USER flowpilot
ARG REVISION=unknown
LABEL org.opencontainers.image.revision=$REVISION
HEALTHCHECK --interval=15s --timeout=5s --start-period=45s --retries=3 CMD ["/app/.venv/bin/python", "/app/scripts/ops_health.py"]

EXPOSE 8080
CMD ["/bin/sh", "/app/scripts/ops_start.sh"]
