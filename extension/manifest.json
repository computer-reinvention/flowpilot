{
  "manifest_version": 3,
  "name": "uber-bookr connector",
  "version": "1.0.0",
  "description": "Connect your Uber account to uber-bookr",
  "permissions": ["cookies", "storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.uber.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
